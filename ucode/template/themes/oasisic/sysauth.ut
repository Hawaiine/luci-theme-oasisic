{#
	luci-theme-oasisic v1.0.0 — Login page
	Oasisic OpenWrt
	Licensed under Apache 2.0
-#}

{%
	http.prepare_content('text/html; charset=UTF-8');
%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="dark">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<title>{{ _('Login') }} - Oasisic</title>

	<meta name="robots" content="noindex, nofollow">
	<meta http-equiv="X-Content-Type-Options" content="nosniff">
	<meta name="format-detection" content="telephone=no, email=no">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
	<meta name="theme-color" content="#1d1d1f">

	<link rel="stylesheet" href="{{ media }}/css/login.css">
	<link rel="icon" type="image/svg+xml" href="{{ media }}/img/logo.svg">
</head>
<body class="oasisic-login-body">
	<div class="oasisic-login-wrapper">
		<div class="oasisic-login-bg" id="loginBg"></div>
		<div class="oasisic-login-overlay"></div>
		<div class="oasisic-login-container">
			<div class="oasisic-login-card">
				<div class="oasisic-login-header">
					<svg viewBox="0 0 32 32" width="48" height="48" fill="none">
						<rect x="2" y="2" width="28" height="28" rx="7" fill="#3b82f6"/>
						<path d="M10 16l4 4 8-8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<h1>Oasisic</h1>
				</div>

				{% if fuser?.default_message: %}
				<div class="alert-message error">
					{{ fuser.default_message }}
				</div>
				{% endif %}

				<form method="post" action="{{ url('admin/login') }}" class="oasisic-login-form">
					{{ csrf_token() }}
					<input type="hidden" name="luci_username" value="{{ fuser?.default ?? 'root' }}">
					
					<div class="oasisic-form-group">
						<label for="luci_username">{{ _('Username') }}</label>
						<input 
							type="text" 
							id="luci_username" 
							name="luci_username" 
							value="{{ fuser?.default ?? 'root' }}"
							autocomplete="username"
							autofocus
							required
						>
					</div>

					<div class="oasisic-form-group">
						<label for="luci_password">{{ _('Password') }}</label>
						<input 
							type="password" 
							id="luci_password" 
							name="luci_password" 
							autocomplete="current-password"
							required
						>
					</div>

					<button type="submit" class="oasisic-login-button">
						{{ _('Login') }}
					</button>
				</form>

				<div class="oasisic-login-footer">
					<p>{{ _('Powered by LuCI') }} · Oasisic Theme v1.0.0</p>
				</div>
			</div>
		</div>
	</div>
	<div class="oasisic-login-wallpaper-credit" id="wallpaperCredit">
		{{ _('Bing daily wallpaper') }} · 6h
	</div>
	<script src="{{ media }}/js/oasisic.js"></script>
	<script src="{{ media }}/js/login.js"></script>
	<script>
		OasisicLogin.init();
	</script>
</body>
</html>
